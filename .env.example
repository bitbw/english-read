# Auth.js
AUTH_SECRET=                        # 运行 npx auth secret 生成
AUTH_URL=http://localhost:5000

# Google OAuth（Google Cloud Console 获取）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth（GitHub Developer Settings 获取）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vercel Postgres（Neon）- Vercel Storage 自动注入，本地需手动填
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Vercel Blob - Vercel 部署自动注入；本地需通过 `vercel env pull .env.local` 获取
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Vercel AI Gateway（短语复习干扰项：GET /api/review/similar-words 多词分支）
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# similar-words 调试（GET /api/review/similar-words；本地 development 下多数日志已默认开启，生产/preview 需显式设 =1）
# SIMILAR_WORDS_CACHE_DISABLE=1   # 全局跳过 unstable_cache，每次请求都重新计算（短语会重新调 LLM）；等价于 dev 下 ?nocache=1，但对该接口所有环境生效
# SIMILAR_WORDS_LLM_LOG=1       # 打印短语 LLM 详情：成功时 [similar-words] phrase LLM raw text；失败时 schema 失败 + rawText + zodIssues
# SIMILAR_WORDS_CACHE_LOG=1     # 打印请求耗时 [similar-words] response { elapsedMs, model }；cache MISS 时另打 [similar-words] cache MISS (computing)

# Google Cloud Translation API v2（/api/dictionary 回退机翻）
GOOGLE_TRANSLATE_API_KEY=

# PostHog（客户端埋点；Project settings → Project API key / Host）
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 阿里云融合认证 - 短信验证码（号码认证控制台「赠送签名 + 赠送模板」）
# 文档见 docs/aliyun/。RAM 需 dypns:SendSmsVerifyCode、CheckSmsVerifyCode
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 控制台的签名名称、模板 CODE；模板变量与 ALIYUN_SMS_TEMPLATE_PARAM 一致（按控制台实际变量名）
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 默认可不填，需与已审核短信模板中变量一致，例如: {"code":"##code##","min":"5"}
# ALIYUN_SMS_TEMPLATE_PARAM=
# 非「默认方案」时填写
# ALIYUN_SMS_SCHEME_NAME=
# OpenAPI 超时（毫秒，可选）：跨境/海外机房连 dypnsapi 易 ConnectTimeout，默认已放宽
# ALIYUN_DYPNS_CONNECT_TIMEOUT_MS=30000
# ALIYUN_DYPNS_READ_TIMEOUT_MS=60000
